<Project>
  <!-- dotnet publish -r <rid> of an app that also references Oriel.Runtime.<rid>, whose native files the publish has
       already copied beside the app. Windows: CEF's bootstrap.exe becomes <OrielExeName>.exe and Oriel.Host.dll
       <OrielExeName>.dll, so every process runs sandboxed (README, Windows). Linux: the native executables get their
       exec bits. OrielLayout=false leaves the publish as it is. -->
  <PropertyGroup>
    <!-- <Exe>.dll is the native host, so the exe cannot take the managed assembly's name. -->
    <OrielExeName Condition="'$(OrielExeName)' == ''">$(AssemblyName)Run</OrielExeName>
  </PropertyGroup>

  <Target Name="OrielWindowsLayout" AfterTargets="Publish"
          Condition="'$(OrielLayout)' != 'false' and $(RuntimeIdentifier.StartsWith('win-'))">
    <PropertyGroup>
      <_OrielPublish>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(PublishDir)'))</_OrielPublish>
    </PropertyGroup>
    <Error Condition="'$(SelfContained)' != 'true'" Text="Oriel's Windows layout needs a self-contained publish (--self-contained): bootstrap.exe starts .NET through hostfxr beside it. OrielLayout=false skips the layout." />
    <Error Condition="'$(PublishSingleFile)' == 'true'" Text="Oriel's Windows layout cannot lay out a single-file publish." />
    <Error Condition="'$(OrielExeName)' == '$(AssemblyName)'" Text="OrielExeName '$(OrielExeName)' is the managed assembly's name; $(OrielExeName).dll must be the native host." />
    <Error Condition="!Exists('$(_OrielPublish)bootstrap.exe') or !Exists('$(_OrielPublish)Oriel.Host.dll')"
           Text="No CEF beside the published app: add a PackageReference to Oriel.Runtime.$(RuntimeIdentifier)." />

    <Copy SourceFiles="$(_OrielPublish)bootstrap.exe" DestinationFiles="$(_OrielPublish)$(OrielExeName).exe" />
    <!-- The shell names taskbar buttons after FileDescription, which bootstrap.exe gives as "CEF Bootstrap Application". -->
    <OrielCopyExeResources Condition="Exists('$(_OrielPublish)$(AssemblyName).exe')"
                           From="$(_OrielPublish)$(AssemblyName).exe" To="$(_OrielPublish)$(OrielExeName).exe" />
    <Copy SourceFiles="$(_OrielPublish)Oriel.Host.dll" DestinationFiles="$(_OrielPublish)$(OrielExeName).dll" />
    <!-- The apphost would start the app unsandboxed, and Oriel.Subprocess.exe would take the sandbox from children. -->
    <Delete Files="$(_OrielPublish)bootstrap.exe;$(_OrielPublish)bootstrapc.exe;$(_OrielPublish)Oriel.Host.dll;$(_OrielPublish)Oriel.Subprocess.exe;$(_OrielPublish)$(AssemblyName).exe" />
    <Message Importance="high" Text="$(MSBuildProjectName) -> $(_OrielPublish)$(OrielExeName).exe (Oriel layout)" />
  </Target>

  <Target Name="OrielLinuxLayout" AfterTargets="Publish"
          Condition="'$(OrielLayout)' != 'false' and $(RuntimeIdentifier.StartsWith('linux-'))">
    <PropertyGroup>
      <_OrielPublish>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(PublishDir)'))</_OrielPublish>
    </PropertyGroup>
    <Error Condition="!Exists('$(_OrielPublish)libcef.so') or !Exists('$(_OrielPublish)Oriel.Subprocess')"
           Text="No CEF beside the published app: add a PackageReference to Oriel.Runtime.$(RuntimeIdentifier)." />
    <!-- NuGet keeps no file modes. chrome-sandbox also needs root:root and 4755, which only an installer can give. -->
    <Exec Condition="'$(OS)' != 'Windows_NT'" Command="chmod +x &quot;$(_OrielPublish)Oriel.Subprocess&quot; &quot;$(_OrielPublish)chrome-sandbox&quot;" />
    <Warning Condition="'$(OS)' == 'Windows_NT'" Text="Published for Linux on Windows: give Oriel.Subprocess and chrome-sandbox their exec bits (chmod +x) when packaging." />
  </Target>

  <!-- macOS: CEF only starts inside an app bundle (the framework and helper apps sit at fixed places in it). After a
       publish for an osx RID, and after a build on a Mac when OrielMacBundle is true, <AppName>.app is laid out beside
       the output: Contents/MacOS holds the app's files, Contents/Frameworks CEF's framework and one helper .app per
       Chromium process type. dotnet run and dotnet watch then start the bundle's executable, so hot reload reaches the
       running app. OrielCefFramework and OrielMacHelper come from Oriel.Runtime.osx-*, or are set by hand. -->
  <PropertyGroup>
    <OrielMacBundleName Condition="'$(OrielMacBundleName)' == ''">$(AssemblyName)</OrielMacBundleName>
    <OrielMacBundleId Condition="'$(OrielMacBundleId)' == ''">dev.oriel.$(AssemblyName.ToLowerInvariant())</OrielMacBundleId>
    <OrielMacBundleVersion Condition="'$(OrielMacBundleVersion)' == ''">$(Version)</OrielMacBundleVersion>
    <OrielMacBundleVersion Condition="'$(OrielMacBundleVersion)' == ''">1.0.0</OrielMacBundleVersion>
    <!-- On by default with Oriel.Runtime.osx-*, whose props set OrielCefFramework: on a Mac nothing else runs. -->
    <_OrielMacDevBundle Condition="$([MSBuild]::IsOSPlatform('OSX')) and ('$(OrielMacBundle)' == 'true' or ('$(OrielMacBundle)' != 'false' and '$(OrielCefFramework)' != ''))">true</_OrielMacDevBundle>
  </PropertyGroup>

  <PropertyGroup Condition="'$(_OrielMacDevBundle)' == 'true'">
    <_OrielMacDevApp>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(OutDir)'))$(OrielMacBundleName).app</_OrielMacDevApp>
    <RunCommand>$(_OrielMacDevApp)/Contents/MacOS/$(AssemblyName)</RunCommand>
    <RunWorkingDirectory>$(_OrielMacDevApp)/Contents/MacOS</RunWorkingDirectory>
  </PropertyGroup>

  <!-- Not on a publish: OrielMacLayout lays the publish out instead. -->
  <Target Name="OrielMacDevBundle" AfterTargets="Build" Condition="'$(_OrielMacDevBundle)' == 'true' and '$(OutputType)' != 'Library' and '$(_IsPublishing)' != 'true'">
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="_OrielMacBundle"
             Properties="_OrielMacFiles=$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(OutDir)'));_OrielMacApp=$(_OrielMacDevApp);_OrielMacExclude=$(OrielMacBundleName).app;OrielCefFramework=$(OrielCefFramework);OrielMacHelper=$(OrielMacHelper);OrielMacSignIdentity=$(OrielMacSignIdentity);OrielMacNotaryProfile=$(OrielMacNotaryProfile);_IsPublishing=$(_IsPublishing)" />
  </Target>

  <Target Name="OrielMacLayout" AfterTargets="Publish"
          Condition="'$(OrielLayout)' != 'false' and $(RuntimeIdentifier.StartsWith('osx-'))">
    <PropertyGroup>
      <_OrielPublish>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(PublishDir)'))</_OrielPublish>
    </PropertyGroup>
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="_OrielMacBundle"
             Properties="_OrielMacFiles=$(_OrielPublish);_OrielMacApp=$(_OrielPublish)$(OrielMacBundleName).app;_OrielMacExclude=$(OrielMacBundleName).app;OrielCefFramework=$(OrielCefFramework);OrielMacHelper=$(OrielMacHelper);OrielMacSignIdentity=$(OrielMacSignIdentity);OrielMacNotaryProfile=$(OrielMacNotaryProfile);_IsPublishing=$(_IsPublishing)" />
  </Target>

  <!-- One helper app per Chromium process type; static, so _OrielMacSign (a CallTarget) sees them too. -->
  <ItemGroup>
    <_OrielMacHelperSuffix Include="main" Suffix="" Id="" />
    <_OrielMacHelperSuffix Include="alerts" Suffix=" (Alerts)" Id=".alerts" />
    <_OrielMacHelperSuffix Include="gpu" Suffix=" (GPU)" Id=".gpu" />
    <_OrielMacHelperSuffix Include="plugin" Suffix=" (Plugin)" Id=".plugin" />
    <_OrielMacHelperSuffix Include="renderer" Suffix=" (Renderer)" Id=".renderer" />
  </ItemGroup>

  <Target Name="_OrielMacBundle">
    <Error Condition="'$(OrielCefFramework)' == '' or !Exists('$(OrielCefFramework)/Chromium Embedded Framework')"
           Text="No CEF framework for the macOS bundle: add a PackageReference to Oriel.Runtime.osx-arm64 (or osx-x64), or set OrielCefFramework to a 'Chromium Embedded Framework.framework'." />
    <Error Condition="'$(OrielMacHelper)' == '' or !Exists('$(OrielMacHelper)')"
           Text="No helper executable for the macOS bundle: add a PackageReference to Oriel.Runtime.osx-*, or set OrielMacHelper to a published Oriel.Subprocess." />
    <PropertyGroup>
      <_OrielPlistHead>&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd"&gt;
&lt;plist version="1.0"&gt;
&lt;dict&gt;
  &lt;key&gt;CFBundlePackageType&lt;/key&gt;&lt;string&gt;APPL&lt;/string&gt;
  &lt;key&gt;CFBundleInfoDictionaryVersion&lt;/key&gt;&lt;string&gt;6.0&lt;/string&gt;
  &lt;key&gt;CFBundleShortVersionString&lt;/key&gt;&lt;string&gt;$(OrielMacBundleVersion)&lt;/string&gt;
  &lt;key&gt;CFBundleVersion&lt;/key&gt;&lt;string&gt;$(OrielMacBundleVersion)&lt;/string&gt;
  &lt;key&gt;LSMinimumSystemVersion&lt;/key&gt;&lt;string&gt;12.0&lt;/string&gt;
  &lt;key&gt;NSHighResolutionCapable&lt;/key&gt;&lt;true/&gt;
  &lt;key&gt;NSSupportsAutomaticGraphicsSwitching&lt;/key&gt;&lt;true/&gt;</_OrielPlistHead>
      <_OrielPlistTail>&lt;/dict&gt;
&lt;/plist&gt;</_OrielPlistTail>
    </PropertyGroup>

    <!-- rsync, not Copy: a publish has thousands of files, and the framework is cloned (cp -c) instead of copied. -->
    <MakeDir Directories="$(_OrielMacApp)/Contents/MacOS;$(_OrielMacApp)/Contents/Frameworks;$(_OrielMacApp)/Contents/Resources" />
    <Exec Command="rsync -a --delete --exclude &quot;/$(_OrielMacExclude)&quot; &quot;$(_OrielMacFiles)&quot; &quot;$(_OrielMacApp)/Contents/MacOS/&quot;" />
    <Exec Condition="!Exists('$(_OrielMacApp)/Contents/Frameworks/Chromium Embedded Framework.framework/Chromium Embedded Framework')"
          Command="cp -c -R &quot;$(OrielCefFramework)&quot; &quot;$(_OrielMacApp)/Contents/Frameworks/&quot; || cp -R &quot;$(OrielCefFramework)&quot; &quot;$(_OrielMacApp)/Contents/Frameworks/&quot;" />
    <WriteLinesToFile File="$(_OrielMacApp)/Contents/Info.plist" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="$(_OrielPlistHead);  &lt;key&gt;CFBundleExecutable&lt;/key&gt;&lt;string&gt;$(AssemblyName)&lt;/string&gt;;  &lt;key&gt;CFBundleIdentifier&lt;/key&gt;&lt;string&gt;$(OrielMacBundleId)&lt;/string&gt;;  &lt;key&gt;CFBundleName&lt;/key&gt;&lt;string&gt;$(OrielMacBundleName)&lt;/string&gt;;$(_OrielPlistTail)" />
    <!-- Chromium finds its helpers by name: "<CFBundleName> Helper (<type>).app" in Contents/Frameworks. -->
    <MakeDir Directories="@(_OrielMacHelperSuffix->'$(_OrielMacApp)/Contents/Frameworks/$(OrielMacBundleName) Helper%(Suffix).app/Contents/MacOS')" />
    <Copy SourceFiles="$(OrielMacHelper)" DestinationFiles="$(_OrielMacApp)/Contents/Frameworks/$(OrielMacBundleName) Helper%(_OrielMacHelperSuffix.Suffix).app/Contents/MacOS/$(OrielMacBundleName) Helper%(_OrielMacHelperSuffix.Suffix)" SkipUnchangedFiles="true" />
    <Exec Command="chmod +x &quot;$(_OrielMacApp)/Contents/Frameworks/$(OrielMacBundleName) Helper&quot;*.app/Contents/MacOS/*" />
    <WriteLinesToFile File="$(_OrielMacApp)/Contents/Frameworks/$(OrielMacBundleName) Helper%(_OrielMacHelperSuffix.Suffix).app/Contents/Info.plist" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="$(_OrielPlistHead);  &lt;key&gt;CFBundleExecutable&lt;/key&gt;&lt;string&gt;$(OrielMacBundleName) Helper%(_OrielMacHelperSuffix.Suffix)&lt;/string&gt;;  &lt;key&gt;CFBundleIdentifier&lt;/key&gt;&lt;string&gt;$(OrielMacBundleId).helper%(_OrielMacHelperSuffix.Id)&lt;/string&gt;;  &lt;key&gt;CFBundleName&lt;/key&gt;&lt;string&gt;$(OrielMacBundleName) Helper%(_OrielMacHelperSuffix.Suffix)&lt;/string&gt;;  &lt;key&gt;LSUIElement&lt;/key&gt;&lt;string&gt;1&lt;/string&gt;;  &lt;key&gt;LSEnvironment&lt;/key&gt;&lt;dict&gt;&lt;key&gt;MallocNanoZone&lt;/key&gt;&lt;string&gt;0&lt;/string&gt;&lt;/dict&gt;;$(_OrielPlistTail)" />
    <Message Importance="high" Text="$(MSBuildProjectName) -> $(_OrielMacApp)" />
    <CallTarget Targets="_OrielMacSign" Condition="'$(OrielMacSignIdentity)' != ''" />
  </Target>

  <!-- OrielMacSignIdentity: a "Developer ID Application: ..." identity, or "-" to sign ad hoc (runs on this Mac only).
       Signs inside out with the hardened runtime, as notarisation needs: every Mach-O in Contents/MacOS (the .NET
       host and runtime), the framework's libraries and the framework, each helper app, then the app.
       OrielMacEntitlements and OrielMacHelperEntitlements replace the default entitlements. -->
  <Target Name="_OrielMacSign">
    <PropertyGroup>
      <OrielMacEntitlements Condition="'$(OrielMacEntitlements)' == ''">$(MSBuildThisFileDirectory)Oriel.mac.entitlements</OrielMacEntitlements>
      <OrielMacHelperEntitlements Condition="'$(OrielMacHelperEntitlements)' == ''">$(MSBuildThisFileDirectory)Oriel.mac.helper.entitlements</OrielMacHelperEntitlements>
      <_OrielSign>codesign --force --timestamp --options runtime --sign &quot;$(OrielMacSignIdentity)&quot;</_OrielSign>
      <_OrielSign Condition="'$(OrielMacSignIdentity)' == '-'">codesign --force --options runtime --sign -</_OrielSign>
      <_OrielFw>$(_OrielMacApp)/Contents/Frameworks/Chromium Embedded Framework.framework</_OrielFw>
    </PropertyGroup>
    <!-- codesign seals everything in Contents/MacOS as code, managed assemblies and JSON too (their signatures go in
         extended attributes, which a DMG or ditto keeps). The app's own executable is signed with the bundle. -->
    <Exec Command="cd &quot;$(_OrielMacApp)/Contents/MacOS&quot; &amp;&amp; find . -type f ! -path ./$(AssemblyName) -print0 | xargs -0 -n 200 $(_OrielSign)" />
    <Exec Command="for f in &quot;$(_OrielFw)/Libraries/&quot;*.dylib; do $(_OrielSign) &quot;$f&quot; || exit 1; done" />
    <Exec Command="$(_OrielSign) &quot;$(_OrielFw)&quot;" />
    <Exec Command="$(_OrielSign) --entitlements &quot;$(OrielMacHelperEntitlements)&quot; &quot;$(_OrielMacApp)/Contents/Frameworks/$(OrielMacBundleName) Helper%(_OrielMacHelperSuffix.Suffix).app&quot;" />
    <Exec Command="$(_OrielSign) --entitlements &quot;$(OrielMacEntitlements)&quot; &quot;$(_OrielMacApp)&quot;" />
    <Exec Command="codesign --verify --strict --deep &quot;$(_OrielMacApp)&quot;" />
    <Message Importance="high" Text="$(MSBuildProjectName) -> $(_OrielMacApp) (signed: $(OrielMacSignIdentity))" />
    <CallTarget Targets="_OrielMacNotarize" Condition="'$(OrielMacNotaryProfile)' != '' and '$(_IsPublishing)' == 'true'" />
  </Target>

  <!-- OrielMacNotaryProfile: a notarytool keychain profile (xcrun notarytool store-credentials <profile> ...). After a
       Developer ID signature, a publish sends the app to Apple's notary service, waits, and staples the ticket. -->
  <Target Name="_OrielMacNotarize">
    <Error Condition="'$(OrielMacSignIdentity)' == '-'" Text="Notarisation needs a Developer ID signature, not an ad-hoc one." />
    <PropertyGroup>
      <_OrielNotaryZip>$(IntermediateOutputPath)$(OrielMacBundleName)-notarize.zip</_OrielNotaryZip>
    </PropertyGroup>
    <Exec Command="ditto -c -k --keepParent &quot;$(_OrielMacApp)&quot; &quot;$(_OrielNotaryZip)&quot;" />
    <Exec Command="xcrun notarytool submit &quot;$(_OrielNotaryZip)&quot; --keychain-profile &quot;$(OrielMacNotaryProfile)&quot; --wait" />
    <Exec Command="xcrun stapler staple &quot;$(_OrielMacApp)&quot;" />
    <Delete Files="$(_OrielNotaryZip)" />
  </Target>

  <UsingTask TaskName="OrielCopyExeResources" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <From ParameterType="System.String" Required="true" />
      <To ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Class" Language="cs"><![CDATA[
using System;
using System.Collections.Generic;
using System.Runtime.InteropServices;

// Gives one exe another's version information and icons: eng/copy-windows-resources.ps1 as a task.
public sealed class OrielCopyExeResources : Microsoft.Build.Utilities.Task
{
    public string From { get; set; }
    public string To { get; set; }

    const uint DataFile = 0x2, ImageResource = 0x20;
    const int Icon = 3, GroupIcon = 14, Version = 16;

    delegate bool EnumNames(IntPtr module, IntPtr type, IntPtr name, IntPtr param);
    delegate bool EnumLanguages(IntPtr module, IntPtr type, IntPtr name, ushort language, IntPtr param);
    [DllImport("kernel32.dll", CharSet = CharSet.Unicode, SetLastError = true)] static extern IntPtr LoadLibraryExW(string path, IntPtr file, uint flags);
    [DllImport("kernel32.dll")] static extern bool FreeLibrary(IntPtr module);
    [DllImport("kernel32.dll")] static extern bool EnumResourceNamesW(IntPtr module, IntPtr type, EnumNames callback, IntPtr param);
    [DllImport("kernel32.dll")] static extern bool EnumResourceLanguagesW(IntPtr module, IntPtr type, IntPtr name, EnumLanguages callback, IntPtr param);
    [DllImport("kernel32.dll")] static extern IntPtr FindResourceExW(IntPtr module, IntPtr type, IntPtr name, ushort language);
    [DllImport("kernel32.dll")] static extern IntPtr LoadResource(IntPtr module, IntPtr resource);
    [DllImport("kernel32.dll")] static extern IntPtr LockResource(IntPtr data);
    [DllImport("kernel32.dll")] static extern uint SizeofResource(IntPtr module, IntPtr resource);
    [DllImport("kernel32.dll", CharSet = CharSet.Unicode, SetLastError = true)] static extern IntPtr BeginUpdateResourceW(string path, bool deleteExisting);
    [DllImport("kernel32.dll", SetLastError = true)] static extern bool UpdateResourceW(IntPtr update, IntPtr type, IntPtr name, ushort language, byte[] data, uint size);
    [DllImport("kernel32.dll", SetLastError = true)] static extern bool EndUpdateResourceW(IntPtr update, bool discard);

    sealed class Entry { public int Type; public object Name; public ushort Language; public byte[] Data; }

    // Names are integer ids or strings (IS_INTRESOURCE).
    static object NameOf(IntPtr name) => ((long)name >> 16) == 0 ? (object)(int)name : Marshal.PtrToStringUni(name);

    static List<Entry> Read(string path, int type)
    {
        var entries = new List<Entry>();
        IntPtr module = LoadLibraryExW(path, IntPtr.Zero, DataFile | ImageResource);
        if (module == IntPtr.Zero) throw new System.ComponentModel.Win32Exception();
        try
        {
            EnumResourceNamesW(module, (IntPtr)type, (m, t, name, p) =>
            {
                EnumResourceLanguagesW(m, t, name, (m2, t2, n2, language, p2) =>
                {
                    IntPtr resource = FindResourceExW(m2, t2, n2, language);
                    var data = new byte[SizeofResource(m2, resource)];
                    Marshal.Copy(LockResource(LoadResource(m2, resource)), data, 0, data.Length);
                    entries.Add(new Entry { Type = type, Name = NameOf(n2), Language = language, Data = data });
                    return true;
                }, IntPtr.Zero);
                return true;
            }, IntPtr.Zero);
        }
        finally { FreeLibrary(module); }
        return entries;
    }

    static void Update(IntPtr update, Entry entry, byte[] data)
    {
        IntPtr name = entry.Name is int id ? (IntPtr)id : Marshal.StringToHGlobalUni((string)entry.Name);
        try
        {
            if (!UpdateResourceW(update, (IntPtr)entry.Type, name, entry.Language, data, data == null ? 0u : (uint)data.Length))
                throw new System.ComponentModel.Win32Exception();
        }
        finally { if (!(entry.Name is int)) Marshal.FreeHGlobal(name); }
    }

    public override bool Execute()
    {
        var types = new List<int> { Version };
        // Icons only when the source has some: an apphost without ApplicationIcon has none, and CEF's beats a blank one.
        if (Read(From, GroupIcon).Count > 0) { types.Add(GroupIcon); types.Add(Icon); }
        var remove = new List<Entry>();
        var add = new List<Entry>();
        foreach (var type in types)
        {
            remove.AddRange(Read(To, type));
            add.AddRange(Read(From, type));
        }
        IntPtr update = BeginUpdateResourceW(To, false);
        if (update == IntPtr.Zero) throw new System.ComponentModel.Win32Exception();
        try
        {
            foreach (var entry in remove) Update(update, entry, null);
            foreach (var entry in add) Update(update, entry, entry.Data);
        }
        catch { EndUpdateResourceW(update, true); throw; }
        if (!EndUpdateResourceW(update, false)) throw new System.ComponentModel.Win32Exception();
        return true;
    }
}
]]></Code>
    </Task>
  </UsingTask>
</Project>
