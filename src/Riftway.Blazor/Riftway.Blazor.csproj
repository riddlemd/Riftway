<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <Description>Blazor Hybrid for Riftway: Razor components run in-process and render into a BrowserWindow.</Description>
    <PackageTags>riftway;blazor;blazor-hybrid;razor;electron;cef;chromium;desktop;cross-platform</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Riftway\Riftway.csproj" />
    <!-- Its build props add _framework/blazor.webview.js to the app's static web assets; they must reach the app. -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView" PrivateAssets="none" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Scripts/*.js" LogicalName="Riftway.Blazor.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Riftway.Tests" />
  </ItemGroup>

</Project>
