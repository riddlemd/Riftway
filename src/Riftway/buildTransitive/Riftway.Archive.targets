<Project>
  <!-- dotnet publish -p:RiftwayPackArchive=true: the published wwwroot becomes resources/app.asar, as Electron's packagers
       pack an app into app.asar, and the loose folder goes. Riftway.Blazor serves from the archive when it is there
       (AsarFileProvider). RiftwayArchiveUnpack / RiftwayArchiveUnpackDir: ;-separated globs kept beside it in
       app.asar.unpacked (@electron/asar's unpack / unpackDir); RiftwayArchiveSource: another published folder. -->
  <!-- RiftwayFuseArchiveIntegrity=true: Electron's EnableEmbeddedAsarIntegrityValidation. The app refuses an archive
       whose header does not match the hash its exe carries (written below, after packing, as Electron's Windows
       Integrity/ElectronAsar resource) and ends the process on any block that does not match (AsarArchive.OpenForApp). -->
  <ItemGroup Condition="'$(RiftwayFuseArchiveIntegrity)' == 'true'">
    <AssemblyMetadata Include="Riftway.Fuse.ArchiveIntegrity" Value="true" />
  </ItemGroup>

  <PropertyGroup>
    <RiftwayPackTool Condition="'$(RiftwayPackTool)' == ''">$(MSBuildThisFileDirectory)..\tools\pack\Riftway.Pack.dll</RiftwayPackTool>
    <RiftwayArchiveSource Condition="'$(RiftwayArchiveSource)' == ''">wwwroot</RiftwayArchiveSource>
  </PropertyGroup>

  <Target Name="RiftwayPackArchive" AfterTargets="Publish" Condition="'$(RiftwayPackArchive)' == 'true'">
    <PropertyGroup>
      <_RiftwayArchivePublish>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(PublishDir)'))</_RiftwayArchivePublish>
      <_RiftwayArchiveSource>$([System.IO.Path]::Combine('$(_RiftwayArchivePublish)', '$(RiftwayArchiveSource)').TrimEnd('\').TrimEnd('/'))</_RiftwayArchiveSource>
      <_RiftwayArchive>$(_RiftwayArchivePublish)resources$([System.IO.Path]::DirectorySeparatorChar)app.asar</_RiftwayArchive>
      <_RiftwayDotnet>$(DOTNET_HOST_PATH)</_RiftwayDotnet>
      <_RiftwayDotnet Condition="'$(_RiftwayDotnet)' == ''">dotnet</_RiftwayDotnet>
      <_RiftwayArchiveHashFile>$(IntermediateOutputPath)riftway-app.asar.sha256</_RiftwayArchiveHashFile>
      <!-- The exe that starts the app: the Windows layout's, else the apphost. -->
      <_RiftwayArchiveExe Condition="'$(RiftwayExeName)' != '' and Exists('$(_RiftwayArchivePublish)$(RiftwayExeName).exe')">$(_RiftwayArchivePublish)$(RiftwayExeName).exe</_RiftwayArchiveExe>
      <_RiftwayArchiveExe Condition="'$(_RiftwayArchiveExe)' == '' and Exists('$(_RiftwayArchivePublish)$(AssemblyName).exe')">$(_RiftwayArchivePublish)$(AssemblyName).exe</_RiftwayArchiveExe>
    </PropertyGroup>
    <!-- Escaped, so MSBuild does not expand the globs against the disk. -->
    <ItemGroup>
      <_RiftwayArchiveArg Include="$([MSBuild]::Escape('$(RiftwayArchiveUnpack)'))" Kind="--unpack" />
      <_RiftwayArchiveArg Include="$([MSBuild]::Escape('$(RiftwayArchiveUnpackDir)'))" Kind="--unpack-dir" />
    </ItemGroup>
    <Error Condition="!Exists('$(_RiftwayArchiveSource)')" Text="RiftwayPackArchive: nothing to pack at $(_RiftwayArchiveSource) (RiftwayArchiveSource names the published folder)." />
    <Error Condition="!Exists('$(RiftwayPackTool)')" Text="RiftwayPackArchive: the packer $(RiftwayPackTool) is missing." />

    <!-- A previous publish's archive and unpacked files would otherwise outlive the files they came from. -->
    <Delete Files="$(_RiftwayArchive)" />
    <RemoveDir Directories="$(_RiftwayArchive).unpacked" />
    <Exec Command="&quot;$(_RiftwayDotnet)&quot; &quot;$(RiftwayPackTool)&quot; pack &quot;$(_RiftwayArchiveSource)&quot; &quot;$(_RiftwayArchive)&quot; --header-hash-file &quot;$(_RiftwayArchiveHashFile)&quot; @(_RiftwayArchiveArg->'%(Kind) &quot;%(Identity)&quot;', ' ')" />
    <RemoveDir Directories="$(_RiftwayArchiveSource)" />

    <!-- Every Windows publish carries the hash, as Electron's packager writes it whether or not the fuse is on. -->
    <ReadLinesFromFile File="$(_RiftwayArchiveHashFile)">
      <Output TaskParameter="Lines" PropertyName="_RiftwayArchiveHash" />
    </ReadLinesFromFile>
    <Error Condition="'$(RiftwayFuseArchiveIntegrity)' == 'true' and $(RuntimeIdentifier.StartsWith('win-')) and ('$(_RiftwayArchiveExe)' == '' or '$(OS)' != 'Windows_NT')"
           Text="RiftwayFuseArchiveIntegrity: the archive's hash goes into the app's exe, which needs a Windows publish on Windows with an exe ($(_RiftwayArchiveExe))." />
    <RiftwayWriteExeResource Condition="'$(_RiftwayArchiveExe)' != '' and '$(OS)' == 'Windows_NT'" Exe="$(_RiftwayArchiveExe)" Type="Integrity" Name="ElectronAsar"
                             Text="[{&quot;file&quot;:&quot;resources\\app.asar&quot;,&quot;alg&quot;:&quot;sha256&quot;,&quot;value&quot;:&quot;$(_RiftwayArchiveHash)&quot;}]" />
  </Target>

  <UsingTask TaskName="RiftwayWriteExeResource" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Exe ParameterType="System.String" Required="true" />
      <Type ParameterType="System.String" Required="true" />
      <Name ParameterType="System.String" Required="true" />
      <Text ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Class" Language="cs"><![CDATA[
using System;
using System.Runtime.InteropServices;
using System.Text;
using Microsoft.Build.Framework;
// Writes one resource (string type and name, neutral language) into an exe: UTF-8 text, as Electron's packager writes
// its Integrity/ElectronAsar JSON.
public sealed class RiftwayWriteExeResource : Microsoft.Build.Utilities.Task
{
    public string Exe { get; set; }
    public string Type { get; set; }
    public string Name { get; set; }
    public string Text { get; set; }
    [DllImport("kernel32.dll", CharSet = CharSet.Unicode, SetLastError = true)] static extern IntPtr BeginUpdateResourceW(string path, bool deleteExisting);
    [DllImport("kernel32.dll", CharSet = CharSet.Unicode, SetLastError = true)] static extern bool UpdateResourceW(IntPtr update, string type, string name, ushort language, byte[] data, uint size);
    [DllImport("kernel32.dll", SetLastError = true)] static extern bool EndUpdateResourceW(IntPtr update, bool discard);
    public override bool Execute()
    {
        var data = Encoding.UTF8.GetBytes(Text);
        IntPtr update = BeginUpdateResourceW(Exe, false);
        if (update == IntPtr.Zero) throw new System.ComponentModel.Win32Exception();
        if (!UpdateResourceW(update, Type, Name, 0, data, (uint)data.Length))
        {
            var error = new System.ComponentModel.Win32Exception();
            EndUpdateResourceW(update, true);
            throw error;
        }
        if (!EndUpdateResourceW(update, false)) throw new System.ComponentModel.Win32Exception();
        Log.LogMessage(MessageImportance.High, Exe + ": " + Type + "/" + Name + " " + Text);
        return true;
    }
}
]]></Code>
    </Task>
  </UsingTask>
</Project>
