<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- V8 in the renderer and SwiftShader in the GPU process write executable memory, as Electron's helpers do. -->
  <key>com.apple.security.cs.allow-jit</key><true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key><true/>
  <!-- CEF's framework and the helpers are signed separately; an ad-hoc or mixed signature fails library validation. -->
  <key>com.apple.security.cs.disable-library-validation</key><true/>
</dict>
</plist>
