<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Riftway.Cef\Riftway.Cef.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <!-- CEF is a C API; the interop layer needs function pointers and raw structs. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <Description>Cross-platform desktop apps for .NET, on one Chromium (CEF), with Blazor Hybrid and an Electron-style API. Not affiliated with the Electron project.</Description>
    <PackageTags>riftway;electron;cef;chromium;desktop;gui;cross-platform;blazor;blazor-hybrid;webview;ipc</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <None Include="buildTransitive\**" Pack="true" PackagePath="buildTransitive\" />
    <!-- The packer Riftway.Archive.targets runs; built first, packed under tools/pack. -->
    <ProjectReference Include="..\Riftway.Pack\Riftway.Pack.csproj" ReferenceOutputAssembly="false" Private="false" PrivateAssets="all" />
    <!-- Injected into every page over DevTools; named by path so WebContents can find them. -->
    <EmbeddedResource Include="Ipc/*.js" LogicalName="Riftway.Ipc.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Riftway.Tests" />
    <InternalsVisibleTo Include="Riftway.WindowTest" />
  </ItemGroup>


  <Target Name="_RiftwayPackTool" BeforeTargets="_GetPackageFiles">
    <MSBuild Projects="..\Riftway.Pack\Riftway.Pack.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_RiftwayPackToolDll" />
    </MSBuild>
    <ItemGroup>
      <_RiftwayPackToolFile Include="@(_RiftwayPackToolDll->'%(RootDir)%(Directory)Riftway.Pack.dll');@(_RiftwayPackToolDll->'%(RootDir)%(Directory)Riftway.Pack.runtimeconfig.json');@(_RiftwayPackToolDll->'%(RootDir)%(Directory)Riftway.Pack.deps.json')" />
      <None Include="@(_RiftwayPackToolFile)" Pack="true" PackagePath="tools\pack\" />
    </ItemGroup>
  </Target>

</Project>
