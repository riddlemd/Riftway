<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Oriel\Oriel.csproj" />
    <PackageReference Include="Velopack" />
  </ItemGroup>

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <Description>Electron's autoUpdater for Oriel apps, over Velopack installers and update feeds.</Description>
    <PackageTags>oriel;autoupdater;velopack</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Oriel.Tests" />
  </ItemGroup>

</Project>
