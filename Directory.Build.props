<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AnalysisLevel>latest</AnalysisLevel>
    <!-- Warnings are errors from the start: a scaffold that prints none keeps it that way. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Authors>Michael Riddle</Authors>
    <Copyright>Copyright (c) 2026 Michael Riddle</Copyright>
    <RepositoryUrl>https://github.com/riddlemd/Oriel</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
