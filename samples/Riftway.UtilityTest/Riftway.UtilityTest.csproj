<Project Sdk="Microsoft.NET.Sdk">

  <!-- What the Riftway package's buildTransitive brings; a ProjectReference doesn't import it. -->
  <Import Project="..\..\src\Riftway\buildTransitive\Riftway.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Riftway\Riftway.csproj" />
    <!-- The child lands beside this app (its .dll, apphost and runtimeconfig), where Program.cs forks it. -->
    <ProjectReference Include="..\Riftway.UtilityTest.Child\Riftway.UtilityTest.Child.csproj" />
    <Content Include="web/**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
