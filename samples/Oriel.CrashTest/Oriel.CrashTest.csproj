<Project Sdk="Microsoft.NET.Sdk">

  <!-- What the Oriel package's buildTransitive brings; a ProjectReference doesn't import it. -->
  <Import Project="..\..\src\Oriel\buildTransitive\Oriel.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Reports carry it as _version (Electron's app.getVersion()). -->
    <Version>1.2.3</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Oriel\Oriel.csproj" />
  </ItemGroup>

</Project>
