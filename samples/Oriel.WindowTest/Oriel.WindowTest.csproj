<Project Sdk="Microsoft.NET.Sdk">

  <!-- What the Oriel package's buildTransitive brings; a ProjectReference doesn't import it. -->
  <Import Project="..\..\src\Oriel\buildTransitive\Oriel.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- The independent X client LinuxClipboardTest runs with python3. -->
    <EmbeddedResource Include="x11clip.py" LogicalName="x11clip.py" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Oriel\Oriel.csproj" />
  </ItemGroup>

</Project>
