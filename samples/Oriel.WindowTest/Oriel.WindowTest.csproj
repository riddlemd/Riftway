<Project Sdk="Microsoft.NET.Sdk">

  <!-- What the Oriel package's buildTransitive brings; a ProjectReference doesn't import it. -->
  <Import Project="..\..\src\Oriel\buildTransitive\Oriel.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Oriel\Oriel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\LauncherEntryMonitor.cs" Link="LauncherEntryMonitor.cs" />
    <Compile Include="..\Shared\FakePortal.cs" Link="FakePortal.cs" />
  </ItemGroup>

</Project>
