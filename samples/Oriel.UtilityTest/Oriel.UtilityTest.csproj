<Project Sdk="Microsoft.NET.Sdk">

  <!-- What the Oriel package's buildTransitive brings; a ProjectReference doesn't import it. -->
  <Import Project="..\..\src\Oriel\buildTransitive\Oriel.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Oriel\Oriel.csproj" />
    <!-- The child lands beside this app (its .dll, apphost and runtimeconfig), where Program.cs forks it. -->
    <ProjectReference Include="..\Oriel.UtilityTest.Child\Oriel.UtilityTest.Child.csproj" />
    <Content Include="web/**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
