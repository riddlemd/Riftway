<Project>
  <!-- Clean removes the whole output and intermediate roots, so a stale file from a renamed or
       deleted source cannot survive a no-incremental build. -->
  <Target Name="DeepClean" AfterTargets="Clean">
    <PropertyGroup>
      <_DeepCleanOutput>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(BaseOutputPath)'))</_DeepCleanOutput>
      <_DeepCleanIntermediate>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(BaseIntermediateOutputPath)'))</_DeepCleanIntermediate>
    </PropertyGroup>
    <RemoveDir Directories="$(_DeepCleanOutput);$(_DeepCleanIntermediate)" />
  </Target>

  <!-- In-repo apps reference Riftway by project, so its buildTransitive targets are imported here; with no
       Riftway.Runtime package, the CEF framework comes from eng/fetch-cef.sh's cache and the helper from
       src/Riftway.Subprocess.Native/build.sh. dotnet build|run|watch -p:RiftwayMacBundle=true runs an app as a bundle on a Mac; dotnet publish -r osx-*
       -p:RiftwayMacBundle=true lays the publish out as one. -->
  <Import Project="src/Riftway/buildTransitive/Riftway.targets" Condition="'$(RiftwayMacBundle)' == 'true' and '$(OutputType)' == 'Exe'" />

  <Target Name="_RiftwayRepoMacInputs" BeforeTargets="RiftwayMacDevBundle;RiftwayMacLayout" Condition="'$(RiftwayMacBundle)' == 'true' and '$(RiftwayCefFramework)' == ''">
    <PropertyGroup>
      <!-- A publish's RID picks the CEF build; a dev build runs on this Mac. -->
      <_RiftwayRepoCefPlatform Condition="'$(RuntimeIdentifier)' == 'osx-arm64'">macosarm64</_RiftwayRepoCefPlatform>
      <_RiftwayRepoCefPlatform Condition="'$(RuntimeIdentifier)' == 'osx-x64'">macosx64</_RiftwayRepoCefPlatform>
      <_RiftwayRepoCefPlatform Condition="'$(_RiftwayRepoCefPlatform)' == '' and '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64'">macosarm64</_RiftwayRepoCefPlatform>
      <_RiftwayRepoCefPlatform Condition="'$(_RiftwayRepoCefPlatform)' == ''">macosx64</_RiftwayRepoCefPlatform>
      <_RiftwayRepoRid Condition="'$(_RiftwayRepoCefPlatform)' == 'macosarm64'">osx-arm64</_RiftwayRepoRid>
      <_RiftwayRepoRid Condition="'$(_RiftwayRepoRid)' == ''">osx-x64</_RiftwayRepoRid>
      <_RiftwayRepoHelperDir>$(MSBuildThisFileDirectory)artifacts/subprocess-$(_RiftwayRepoRid)/</_RiftwayRepoHelperDir>
    </PropertyGroup>
    <Exec Command="&quot;$(MSBuildThisFileDirectory)eng/fetch-cef.sh&quot; $(_RiftwayRepoCefPlatform)" ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_RiftwayRepoCef" />
    </Exec>
    <!-- The native helper (sandbox-capable); rebuilt when its source changes. -->
    <Exec Condition="!Exists('$(_RiftwayRepoHelperDir)Riftway.Subprocess') or $([System.IO.File]::GetLastWriteTime('$(MSBuildThisFileDirectory)src/Riftway.Subprocess.Native/subprocess.c').Ticks) &gt; $([System.IO.File]::GetLastWriteTime('$(_RiftwayRepoHelperDir)Riftway.Subprocess').Ticks)"
          Command="&quot;$(MSBuildThisFileDirectory)src/Riftway.Subprocess.Native/build.sh&quot; &quot;$(_RiftwayRepoHelperDir)Riftway.Subprocess&quot; $(_RiftwayRepoCefPlatform)" StandardOutputImportance="low" />
    <PropertyGroup>
      <RiftwayCefFramework>$(_RiftwayRepoCef)/Release/Chromium Embedded Framework.framework</RiftwayCefFramework>
      <RiftwayMacHelper>$(_RiftwayRepoHelperDir)Riftway.Subprocess</RiftwayMacHelper>
    </PropertyGroup>
  </Target>

  <Import Project="eng/windows-layout.targets" Condition="'$(RiftwayWindowsLayout)' == 'true'" />

  <!-- RiftwayPackArchive for in-repo apps: the archive step (also imported by Riftway.targets above, on a Mac bundle) and
       the packer built from src/Riftway.Pack rather than taken from the package. -->
  <Import Project="src/Riftway/buildTransitive/Riftway.Archive.targets" Condition="'$(RiftwayPackArchive)' == 'true' and '$(OutputType)' == 'Exe' and !('$(RiftwayMacBundle)' == 'true')" />
  <Target Name="_RiftwayRepoPackTool" BeforeTargets="RiftwayPackArchive" Condition="'$(RiftwayPackArchive)' == 'true' and '$(OutputType)' == 'Exe'">
    <MSBuild Projects="$(MSBuildThisFileDirectory)src/Riftway.Pack/Riftway.Pack.csproj" Targets="Build"
             Properties="Configuration=$(Configuration)"
             RemoveProperties="RuntimeIdentifier;SelfContained;PublishDir;OutputPath;RiftwayPackArchive;RiftwayWindowsLayout;RiftwayExeName;RiftwayMacBundle">
      <Output TaskParameter="TargetOutputs" PropertyName="RiftwayPackTool" />
    </MSBuild>
  </Target>
</Project>
