+#if CEF_API_ADDED(CEF_NEXT)
+  ///
+  /// Called on the browser process UI thread when a child process that is not
+  /// a renderer crashes, is killed or fails to launch (GPU, utility and other
+  /// processes; see CefRequestHandler::OnRenderProcessTerminated for
+  /// renderers). |type| is the English name of the process type, such as
+  /// "GPU", "Utility", "Zygote" or "Sandbox helper". |status| says how it went
+  /// and |exit_code| is its exit code, or the platform's launch error for
+  /// TS_LAUNCH_FAILED. |service_name| is the name the process reports metrics
+  /// under (for a utility process, its service, such as
+  /// "network.mojom.NetworkService"). |name| is its display name, which may
+  /// be empty. |system_error_code| is the Windows error of a failed launch,
+  /// and 0 otherwise.
+  ///
+  /*--cef(added=next,optional_param=service_name,optional_param=name)--*/
+  virtual void OnChildProcessGone(const CefString& type,
+                                  cef_termination_status_t status,
+                                  int exit_code,
+                                  const CefString& service_name,
+                                  const CefString& name,
+                                  uint32_t system_error_code) {}
+#endif
 };
 
 #endif  // CEF_INCLUDE_CEF_BROWSER_PROCESS_HANDLER_H_
