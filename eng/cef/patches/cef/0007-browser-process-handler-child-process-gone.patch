+// Reports the non-renderer child processes that crash, are killed or fail to
+// launch, as Electron's App does for child-process-gone.
+class CefChildProcessObserver : public content::BrowserChildProcessObserver {
+ public:
+  explicit CefChildProcessObserver(CefRefPtr<CefApp> application)
+      : application_(application) {
+    content::BrowserChildProcessObserver::Add(this);
+  }
+
+  CefChildProcessObserver(const CefChildProcessObserver&) = delete;
+  CefChildProcessObserver& operator=(const CefChildProcessObserver&) = delete;
+
+  ~CefChildProcessObserver() override {
+    content::BrowserChildProcessObserver::Remove(this);
+  }
+
+  void BrowserChildProcessCrashed(
+      const content::ChildProcessData& data,
+      const content::ChildProcessTerminationInfo& info) override {
+    Notify(data, info);
+  }
+
+  void BrowserChildProcessKilled(
+      const content::ChildProcessData& data,
+      const content::ChildProcessTerminationInfo& info) override {
+    Notify(data, info);
+  }
+
+  void BrowserChildProcessLaunchFailed(
+      const content::ChildProcessData& data,
+      const content::ChildProcessTerminationInfo& info) override {
+    Notify(data, info);
+  }
+
+ private:
+  void Notify(const content::ChildProcessData& data,
+              const content::ChildProcessTerminationInfo& info) {
+    // A client built against an older API version has no OnChildProcessGone.
+    if (!CEF_API_IS_ADDED(CEF_NEXT)) {
+      return;
+    }
+    auto handler = application_->GetBrowserProcessHandler();
+    if (!handler) {
+      return;
+    }
+
+    // As CefBrowserContentsDelegate::RenderProcessGone.
+    cef_termination_status_t status = TS_ABNORMAL_TERMINATION;
+    if (info.status == base::TERMINATION_STATUS_PROCESS_WAS_KILLED) {
+      status = TS_PROCESS_WAS_KILLED;
+    } else if (info.status == base::TERMINATION_STATUS_PROCESS_CRASHED) {
+      status = TS_PROCESS_CRASHED;
+    } else if (info.status == base::TERMINATION_STATUS_OOM) {
+      status = TS_PROCESS_OOM;
+    } else if (info.status == base::TERMINATION_STATUS_LAUNCH_FAILED) {
+      status = TS_LAUNCH_FAILED;
+#if BUILDFLAG(IS_WIN)
+    } else if (info.status == base::TERMINATION_STATUS_INTEGRITY_FAILURE) {
+      status = TS_INTEGRITY_FAILURE;
+#endif
+    }
+
+    uint32_t system_error_code = 0;
+#if BUILDFLAG(IS_WIN)
+    if (info.status == base::TERMINATION_STATUS_LAUNCH_FAILED) {
+      system_error_code = static_cast<uint32_t>(info.last_error);
+    }
+#endif
+
+    handler->OnChildProcessGone(
+        content::GetProcessTypeNameInEnglish(data.process_type), status,
+        info.exit_code, data.metrics_name, data.name, system_error_code);
+  }
+
+  CefRefPtr<CefApp> application_;
+};
+
 // CefContext
 
 CefContext::CefContext() = default;
