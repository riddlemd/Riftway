+// Reports Chromium's GPU info updates to the client and answers
+// CefBrowserHost::GetGpuInfo's complete requests from them, as Electron's
+// GPUInfoManager.
+class CefGpuInfoObserver : public content::GpuDataManagerObserver {
+ public:
+  explicit CefGpuInfoObserver(CefRefPtr<CefApp> application)
+      : application_(application) {
+    content::GpuDataManager::GetInstance()->AddObserver(this);
+  }
+
+  CefGpuInfoObserver(const CefGpuInfoObserver&) = delete;
+  CefGpuInfoObserver& operator=(const CefGpuInfoObserver&) = delete;
+
+  ~CefGpuInfoObserver() override {
+    content::GpuDataManager::GetInstance()->RemoveObserver(this);
+  }
+
+  void RequestCompleteInfo(CefRefPtr<CefGpuInfoCallback> callback) {
+    auto* manager = content::GpuDataManagerImpl::GetInstance();
+    // Chromium collects DirectX info once and sends no update when asked
+    // again, so a request after it is in would otherwise wait forever.
+    if (HasCompleteInfo()) {
+      callback->OnGpuInfo(CreateGpuInfoValue(manager->GetGPUInfo()),
+                          CefString());
+      return;
+    }
+    pending_.push_back(callback);
+    if (!timeout_.IsRunning()) {
+      timeout_.Start(FROM_HERE, base::Seconds(10),
+                     base::BindOnce(&CefGpuInfoObserver::AnswerPending,
+                                    base::Unretained(this)));
+    }
+    // Dawn info is not part of gpu::GPUInfo, and collecting it can stall the
+    // GPU main thread for seconds.
+    manager->RequestGpuInfoIfNeeded(
+        static_cast<content::GpuDataManagerImpl::GpuInfoRequest>(
+            content::GpuDataManagerImpl::kGpuInfoRequestDirectX |
+            content::GpuDataManagerImpl::kGpuInfoRequestVideo),
+        /*delayed=*/false);
+  }
+
+  void OnGpuInfoUpdate() override {
+    // The video and DirectX reports come separately; answer once both are in.
+    if (HasCompleteInfo()) {
+      AnswerPending();
+    }
+    // A client built against an older API version has no callback for it.
+    if (application_ && CEF_API_IS_ADDED(CEF_NEXT)) {
+      if (auto handler = application_->GetBrowserProcessHandler()) {
+        handler->OnGpuInfoUpdate();
+      }
+    }
+  }
+
+ private:
+  static bool HasCompleteInfo() {
+    auto* manager = content::GpuDataManagerImpl::GetInstance();
+#if BUILDFLAG(IS_WIN)
+    if (!manager->DirectXRequested() ||
+        !manager->IsDx12VulkanVersionAvailable()) {
+      return false;
+    }
+#endif
+    return !manager->GetGPUInfo()
+                .video_decode_accelerator_supported_profiles.empty();
+  }
+
+  void AnswerPending() {
+    timeout_.Stop();
+    if (pending_.empty()) {
+      return;
+    }
+    auto callbacks = std::move(pending_);
+    pending_.clear();
+    const gpu::GPUInfo gpu_info =
+        content::GpuDataManagerImpl::GetInstance()->GetGPUInfo();
+    for (auto& callback : callbacks) {
+      callback->OnGpuInfo(CreateGpuInfoValue(gpu_info), CefString());
+    }
+  }
+
+  CefRefPtr<CefApp> application_;
+  std::vector<CefRefPtr<CefGpuInfoCallback>> pending_;
+  base::OneShotTimer timeout_;
+};
+
+// static
+void CefBrowserHost::GetGpuInfo(bool complete,
+                                CefRefPtr<CefGpuInfoCallback> callback) {
+  CEF_REQUIRE_UIT_RETURN_VOID();
+  std::string reason;
+  if (!content::GpuDataManagerImpl::GetInstance()->GpuAccessAllowed(&reason)) {
+    callback->OnGpuInfo(nullptr, "GPU access not allowed. Reason: " + reason);
+    return;
+  }
+
+#if BUILDFLAG(IS_WIN) || BUILDFLAG(IS_MAC)
+  if (complete && CONTEXT_STATE_VALID() && g_context->gpu_info_observer()) {
+    g_context->gpu_info_observer()->RequestCompleteInfo(callback);
+    return;
+  }
+#endif
+
+  // Collection blocks: on Windows it loads system libraries.
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce([]() {
+        gpu::GPUInfo gpu_info;
+        gpu::CollectBasicGraphicsInfo(&gpu_info);
+        return gpu_info;
+      }),
+      base::BindOnce(
+          [](CefRefPtr<CefGpuInfoCallback> callback,
+             const gpu::GPUInfo& gpu_info) {
+            callback->OnGpuInfo(CreateGpuInfoValue(gpu_info), CefString());
+          },
+          callback));
+}
+
+// static
+CefRefPtr<CefDictionaryValue> CefBrowserHost::GetGpuFeatureStatus() {
+  CEF_REQUIRE_UIT_RETURN(nullptr);
+  return new CefDictionaryValueImpl(content::GetFeatureStatus(),
+                                    /*read_only=*/false);
+}
+
+// static
+bool CefBrowserHost::IsHardwareAccelerationEnabled() {
+  return content::GpuDataManager::Initialized() &&
+         content::GpuDataManager::GetInstance()->HardwareAccelerationEnabled();
+}
