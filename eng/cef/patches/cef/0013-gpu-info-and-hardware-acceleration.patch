+// Reads gpu::GPUInfo with the keys and nesting of Electron's
+// GPUInfoEnumerator, which app.getGPUInfo returns.
+class CefGpuInfoEnumerator final : public gpu::GPUInfo::Enumerator {
+ public:
+  static base::DictValue Enumerate(const gpu::GPUInfo& gpu_info) {
+    CefGpuInfoEnumerator enumerator;
+    gpu_info.EnumerateFields(&enumerator);
+    return std::move(enumerator.current_);
+  }
+
+  void AddInt64(const char* name, int64_t value) override {
+    // base::Value has no 64-bit integer; Electron narrows the same way.
+    current_.Set(name, static_cast<int>(value));
+  }
+  void AddInt(const char* name, int value) override {
+    current_.Set(name, value);
+  }
+  void AddString(const char* name, const std::string& value) override {
+    if (!value.empty()) {
+      current_.Set(name, value);
+    }
+  }
+  void AddBool(const char* name, bool value) override {
+    current_.Set(name, value);
+  }
+  void AddTimeDeltaInSecondsF(const char* name,
+                              const base::TimeDelta& value) override {
+    current_.Set(name, value.InMillisecondsF());
+  }
+  void AddBinary(const char* name,
+                 const base::span<const uint8_t>& value) override {
+    current_.Set(name, base::Value(value));
+  }
+
+  void BeginGPUDevice() override { Begin(); }
+  void EndGPUDevice() override {
+    // Every device goes in one list, the active one first.
+    base::DictValue device = End();
+    current_.EnsureList("gpuDevice")->Append(std::move(device));
+  }
+  void BeginVideoDecodeAcceleratorSupportedProfile() override { Begin(); }
+  void EndVideoDecodeAcceleratorSupportedProfile() override {
+    End("videoDecodeAcceleratorSupportedProfile");
+  }
+  void BeginVideoEncodeAcceleratorSupportedProfile() override { Begin(); }
+  void EndVideoEncodeAcceleratorSupportedProfile() override {
+    End("videoEncodeAcceleratorSupportedProfile");
+  }
+  void BeginAuxAttributes() override { Begin(); }
+  void EndAuxAttributes() override { End("auxAttributes"); }
+  void BeginOverlayInfo() override { Begin(); }
+  void EndOverlayInfo() override { End("overlayInfo"); }
+
+ private:
+  void Begin() {
+    parents_.push_back(std::move(current_));
+    current_ = base::DictValue();
+  }
+  base::DictValue End() {
+    base::DictValue child = std::move(current_);
+    current_ = std::move(parents_.back());
+    parents_.pop_back();
+    return child;
+  }
+  void End(const char* key) {
+    base::DictValue child = End();
+    current_.Set(key, std::move(child));
+  }
+
+  std::vector<base::DictValue> parents_;
+  base::DictValue current_;
+};
+
+CefRefPtr<CefDictionaryValue> CreateGpuInfoValue(
+    const gpu::GPUInfo& gpu_info) {
+  return new CefDictionaryValueImpl(CefGpuInfoEnumerator::Enumerate(gpu_info),
+                                    /*read_only=*/false);
+}
