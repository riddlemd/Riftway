+// The client's process-wide accessibility mode, as Electron's App keeps one
+// ScopedAccessibilityMode, and the flags Chromium adds by itself.
+class CefAccessibilityState : public ui::AXModeObserver {
+ public:
+  explicit CefAccessibilityState(CefRefPtr<CefApp> application)
+      : application_(application) {
+    ui::AXPlatform::GetInstance().AddModeObserver(this);
+  }
+
+  CefAccessibilityState(const CefAccessibilityState&) = delete;
+  CefAccessibilityState& operator=(const CefAccessibilityState&) = delete;
+
+  ~CefAccessibilityState() override {
+    ui::AXPlatform::GetInstance().RemoveModeObserver(this);
+  }
+
+  void SetMode(ui::AXMode mode) {
+    // Additions are observed synchronously; the client's own are not news.
+    base::AutoReset<bool> setting(&setting_, true);
+    if (mode.is_mode_off()) {
+      scoped_mode_.reset();
+    } else {
+      scoped_mode_ = content::BrowserAccessibilityState::GetInstance()
+                         ->CreateScopedModeForProcess(mode);
+    }
+  }
+
+  void OnAXModeAdded(ui::AXMode mode) override {
+    // A client built against an older API version has no callback for it.
+    if (setting_ || !CEF_API_IS_ADDED(CEF_NEXT)) {
+      return;
+    }
+    if (auto handler = application_->GetBrowserProcessHandler()) {
+      handler->OnAccessibilityModeChanged(static_cast<int>(
+          content::BrowserAccessibilityState::GetInstance()
+              ->GetAccessibilityMode()
+              .flags()));
+    }
+  }
+
+ private:
+  CefRefPtr<CefApp> application_;
+  std::unique_ptr<content::ScopedAccessibilityMode> scoped_mode_;
+  bool setting_ = false;
+};
+
+// static
+int CefBrowserHost::GetProcessAccessibilityMode() {
+  CEF_REQUIRE_UIT_RETURN(0);
+  return static_cast<int>(content::BrowserAccessibilityState::GetInstance()
+                              ->GetAccessibilityMode()
+                              .flags());
+}
+
+// static
+void CefBrowserHost::SetProcessAccessibilityMode(int mode) {
+  CEF_REQUIRE_UIT_RETURN_VOID();
+  if (!CONTEXT_STATE_VALID() || !g_context->accessibility_state()) {
+    return;
+  }
+  // kFromPlatform is reserved for platform activation, which tests may block.
+  const uint32_t known = (ui::AXMode::kLastModeFlag << 1) - 1;
+  g_context->accessibility_state()->SetMode(ui::AXMode(
+      static_cast<uint32_t>(mode) & known & ~ui::AXMode::kFromPlatform));
+}
+
 // CefContext
 
 CefContext::CefContext() = default;
