 namespace {
 
 #if BUILDFLAG(IS_OZONE)
@@ -513,6 +518,10 @@ void CefWindowImpl::OnWindowViewDeleted() {
 
   destroyed_ = true;
   widget_ = nullptr;
+#if BUILDFLAG(IS_LINUX)
+  // The host is gone with the widget; drop its closure unrun.
+  enable_event_listening_.ReplaceClosure(base::OnceClosure());
+#endif
 
   if (delegate()) {
     delegate()->OnWindowDestroyed(this);
@@ -904,6 +913,28 @@ cef_runtime_style_t CefWindowImpl::GetRuntimeStyle() {
   return CEF_RUNTIME_STYLE_DEFAULT;
 }
 
+void CefWindowImpl::SetEventListeningEnabled(bool enabled) {
+  CEF_REQUIRE_VALID_RETURN_VOID();
+#if BUILDFLAG(IS_LINUX)
+  if (enabled) {
+    enable_event_listening_.RunAndReset();
+    return;
+  }
+  // DisableEventListening counts its callers (file dialogs use it too), so it
+  // is called once per disable and undone only by its own closure.
+  if (enable_event_listening_ || !widget_ || !widget_->GetNativeWindow()) {
+    return;
+  }
+  // Every CefWindow widget is a DesktopNativeWidgetAura on Linux, as in
+  // Electron's NativeWindowViews::SetEnabledInternal.
+  auto* host = static_cast<views::DesktopWindowTreeHostLinux*>(
+      widget_->GetNativeWindow()->GetHost());
+  if (host) {
+    enable_event_listening_.ReplaceClosure(host->DisableEventListening());
+  }
+#endif
+}
+
 CefWindowView* CefWindowImpl::cef_window_view() const {
   return static_cast<CefWindowView*>(root_view());
 }
