Riftway CEF patch 0002: CefWindow::SetEventListeningEnabled.

Lets a client stop a Window from receiving input on Linux the way Electron's
NativeWindowViews::SetEnabledInternal does for setEnabled(false) and for the
parent of a shown modal: DesktopWindowTreeHostLinux::DisableEventListening
swaps in a null event targeter, so no mouse, key, touch or pointer crossing
event reaches the window's Views or contents, while activation is untouched.
The method is API at CEF_NEXT (999998): API version 15400 and its hash are
unchanged.

Resolves: Riftway docs/DRIFT.md W5 (and MB4's window side).
Base: CEF a03e714 (branch 8037, CEF 154) with 0001. Applies in chromium/src/cef.

diff --git a/include/views/cef_window.h b/include/views/cef_window.h
index 06221be..a7be650 100644
--- a/include/views/cef_window.h
+++ b/include/views/cef_window.h
@@ -38,6 +38,7 @@
 #define CEF_INCLUDE_VIEWS_CEF_WINDOW_H_
 #pragma once
 
+#include "include/cef_api_hash.h"
 #include "include/cef_image.h"
 #include "include/cef_menu_model.h"
 #include "include/views/cef_display.h"
@@ -431,6 +432,19 @@ class CefWindow : public CefPanel {
   ///
   /*--cef(default_retval=CEF_RUNTIME_STYLE_DEFAULT)--*/
   virtual cef_runtime_style_t GetRuntimeStyle() = 0;
+
+#if CEF_API_ADDED(CEF_NEXT)
+  ///
+  /// Set whether this Window listens for input events. While disabled no
+  /// mouse, keyboard, touch or pointer crossing event reaches the Window's
+  /// Views or browser contents, as for the parent of a modal dialog. The
+  /// Window can still be activated and focused. Only implemented on Linux,
+  /// where Chromium swaps in a null event targeter for the Window; does
+  /// nothing on other platforms.
+  ///
+  /*--cef(added=next)--*/
+  virtual void SetEventListeningEnabled(bool enabled) = 0;
+#endif
 };
 
 #endif  // CEF_INCLUDE_VIEWS_CEF_WINDOW_H_
