+void CefRequestContextImpl::ResolveProxy(
+    const CefString& url,
+    CefRefPtr<CefResolveProxyCallback> callback) {
+  GetBrowserContext(content::GetUIThreadTaskRunner({}),
+                    base::BindOnce(&ResolveProxyInternal, url, callback));
+}
+
+// static
+void CefRequestContext::ResolveSystemProxy(
+    const CefString& url,
+    CefRefPtr<CefResolveProxyCallback> callback) {
+  if (!CONTEXT_STATE_VALID()) {
+    DCHECK(false) << "context not valid";
+    return;
+  }
+  if (!CEF_CURRENTLY_ON_UIT()) {
+    CEF_POST_TASK(CEF_UIT, base::BindOnce(&CefRequestContext::ResolveSystemProxy,
+                                          url, callback));
+    return;
+  }
+  // The system network context follows Local State's "proxy" preference.
+  (new ResolveProxyHelper(callback))
+      ->Start(g_browser_process->system_network_context_manager()->GetContext(),
+              GURL(url.ToString()));
+}
