+// One proxy lookup, as Electron's ResolveProxyHelper; deletes itself once the
+// network context answers or goes away.
+class ResolveProxyHelper : public network::mojom::ProxyLookupClient {
+ public:
+  explicit ResolveProxyHelper(CefRefPtr<CefResolveProxyCallback> callback)
+      : callback_(callback) {}
+
+  ResolveProxyHelper(const ResolveProxyHelper&) = delete;
+  ResolveProxyHelper& operator=(const ResolveProxyHelper&) = delete;
+
+  void Start(network::mojom::NetworkContext* network_context, const GURL& url) {
+    CEF_REQUIRE_UIT();
+    network_context->LookUpProxyForURL(url, net::NetworkAnonymizationKey(),
+                                       receiver_.BindNewPipeAndPassRemote());
+    receiver_.set_disconnect_handler(
+        base::BindOnce(&ResolveProxyHelper::OnProxyLookupComplete,
+                       base::Unretained(this), net::ERR_ABORTED, std::nullopt));
+  }
+
+ private:
+  void OnProxyLookupComplete(
+      int32_t net_error,
+      const std::optional<net::ProxyInfo>& proxy_info) override {
+    CEF_REQUIRE_UIT();
+    receiver_.reset();
+    callback_->OnResolveProxyCompleted(
+        static_cast<cef_errorcode_t>(net_error),
+        proxy_info ? proxy_info->ToPacString() : std::string());
+    delete this;
+  }
+
+  CefRefPtr<CefResolveProxyCallback> callback_;
+  mojo::Receiver<network::mojom::ProxyLookupClient> receiver_{this};
+};
+
+void ResolveProxyInternal(const CefString& url,
+                          CefRefPtr<CefResolveProxyCallback> callback,
+                          CefBrowserContext::Getter browser_context_getter) {
+  auto browser_context = browser_context_getter.Run();
+  if (!browser_context) {
+    callback->OnResolveProxyCompleted(ERR_ABORTED, CefString());
+    return;
+  }
+  (new ResolveProxyHelper(callback))
+      ->Start(browser_context->GetNetworkContext(), GURL(url.ToString()));
+}
