+void CefRequestContextImpl::StartNetLog(
+    const CefString& path,
+    int capture_mode,
+    int64_t max_file_size,
+    CefRefPtr<CefNetLogCallback> callback) {
+  net::NetLogCaptureMode mode = net::NetLogCaptureMode::kDefault;
+  if (capture_mode == 1) {
+    mode = net::NetLogCaptureMode::kIncludeSensitive;
+  } else if (capture_mode == 2) {
+    mode = net::NetLogCaptureMode::kEverything;
+  }
+  const uint64_t max_size =
+      max_file_size < 0 ? network::mojom::NetLogExporter::kUnlimitedFileSize
+                        : static_cast<uint64_t>(max_file_size);
+  GetBrowserContext(
+      content::GetUIThreadTaskRunner({}),
+      base::BindOnce(&StartNetLogInternal, base::FilePath(path), mode,
+                     max_size, callback));
+}
+
+void CefRequestContextImpl::StopNetLog(
+    CefRefPtr<CefNetLogCallback> callback) {
+  GetBrowserContext(content::GetUIThreadTaskRunner({}),
+                    base::BindOnce(&StopNetLogInternal, callback));
+}
+
+bool CefRequestContextImpl::IsNetLogging() {
+  if (!VerifyBrowserContext()) {
+    return false;
+  }
+  auto* net_log = NetLogExport::Get(browser_context()->AsBrowserContext());
+  return net_log && net_log->IsLogging();
+}
