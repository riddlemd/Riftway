+const char kNetLogKey[] = "cef_net_log";
+
+// The profile's net log, as Electron's NetLog is one per session. Owned by the
+// profile, so an export never stopped ends with it.
+class NetLogExport : public base::SupportsUserData::Data {
+ public:
+  static NetLogExport* Get(content::BrowserContext* context) {
+    return static_cast<NetLogExport*>(context->GetUserData(kNetLogKey));
+  }
+
+  static NetLogExport* GetOrCreate(content::BrowserContext* context) {
+    auto* net_log = Get(context);
+    if (!net_log) {
+      auto owned = std::make_unique<NetLogExport>();
+      net_log = owned.get();
+      context->SetUserData(kNetLogKey, std::move(owned));
+    }
+    return net_log;
+  }
+
+  bool IsLogging() const { return exporter_.is_bound(); }
+
+  void Start(network::mojom::NetworkContext* network_context,
+             const base::FilePath& path,
+             net::NetLogCaptureMode capture_mode,
+             uint64_t max_file_size,
+             CefRefPtr<CefNetLogCallback> callback) {
+    if (exporter_.is_bound()) {
+      callback->OnNetLogComplete("There is already a net log running");
+      return;
+    }
+    network_context->CreateNetLogExporter(
+        exporter_.BindNewPipeAndPassReceiver());
+    exporter_.set_disconnect_handler(
+        base::BindOnce(&NetLogExport::OnDisconnect, base::Unretained(this)));
+    pending_start_ = callback;
+    base::ThreadPool::PostTaskAndReplyWithResult(
+        FROM_HERE,
+        {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+         base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN},
+        base::BindOnce(
+            [](const base::FilePath& path) {
+              return base::File(
+                  path, base::File::FLAG_CREATE_ALWAYS | base::File::FLAG_WRITE);
+            },
+            path),
+        base::BindOnce(&NetLogExport::OnFileOpened, weak_factory_.GetWeakPtr(),
+                       capture_mode, max_file_size));
+  }
+
+  void Stop(CefRefPtr<CefNetLogCallback> callback) {
+    if (!exporter_.is_bound()) {
+      callback->OnNetLogComplete("No net log in progress");
+      return;
+    }
+    // The reply keeps the pipe open until the file is complete; a dropped
+    // reply still answers, with ERR_FAILED, as Electron's stopLogging.
+    mojo::Remote<network::mojom::NetLogExporter> exporter =
+        std::move(exporter_);
+    exporter.set_disconnect_handler(base::DoNothing());
+    auto* proxy = exporter.get();
+    proxy->Stop(base::DictValue(),
+                mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+                    base::BindOnce(
+                        [](mojo::Remote<network::mojom::NetLogExporter>,
+                           CefRefPtr<CefNetLogCallback> callback,
+                           int32_t error) {
+                          callback->OnNetLogComplete(ErrorText(error));
+                        },
+                        std::move(exporter), callback),
+                    static_cast<int32_t>(net::ERR_FAILED)));
+  }
+
+ private:
+  CefRefPtr<CefNetLogCallback> TakePendingStart() {
+    return std::move(pending_start_);
+  }
+
+  static std::string ErrorText(int32_t error) {
+    return error == net::OK ? std::string() : net::ErrorToString(error);
+  }
+
+  void OnFileOpened(net::NetLogCaptureMode capture_mode,
+                    uint64_t max_file_size,
+                    base::File file) {
+    if (!pending_start_) {
+      return;
+    }
+    if (!exporter_.is_bound()) {
+      TakePendingStart()->OnNetLogComplete("Failed to start net log exporter");
+      return;
+    }
+    if (!file.IsValid()) {
+      exporter_.reset();
+      TakePendingStart()->OnNetLogComplete(
+          base::File::ErrorToString(file.error_details()));
+      return;
+    }
+    exporter_->Start(std::move(file),
+                     CefAppManager::Get()
+                         ->GetContentClient()
+                         ->browser()
+                         ->GetNetLogConstants(),
+                     capture_mode, net::NetLogFileFormat::kJson, max_file_size,
+                     base::BindOnce(&NetLogExport::OnStarted,
+                                    weak_factory_.GetWeakPtr()));
+  }
+
+  void OnStarted(int32_t error) {
+    if (pending_start_) {
+      TakePendingStart()->OnNetLogComplete(ErrorText(error));
+    }
+  }
+
+  void OnDisconnect() {
+    exporter_.reset();
+    if (pending_start_) {
+      TakePendingStart()->OnNetLogComplete("Failed to start net log exporter");
+    }
+  }
+
+  mojo::Remote<network::mojom::NetLogExporter> exporter_;
+  CefRefPtr<CefNetLogCallback> pending_start_;
+  base::WeakPtrFactory<NetLogExport> weak_factory_{this};
+};
+
+void StartNetLogInternal(const base::FilePath& path,
+                         net::NetLogCaptureMode capture_mode,
+                         uint64_t max_file_size,
+                         CefRefPtr<CefNetLogCallback> callback,
+                         CefBrowserContext::Getter browser_context_getter) {
+  auto browser_context = browser_context_getter.Run();
+  if (!browser_context) {
+    callback->OnNetLogComplete("Failed to start net log exporter");
+    return;
+  }
+  NetLogExport::GetOrCreate(browser_context->AsBrowserContext())
+      ->Start(browser_context->GetNetworkContext(), path, capture_mode,
+              max_file_size, callback);
+}
+
+void StopNetLogInternal(CefRefPtr<CefNetLogCallback> callback,
+                        CefBrowserContext::Getter browser_context_getter) {
+  auto browser_context = browser_context_getter.Run();
+  auto* net_log = browser_context
+                      ? NetLogExport::Get(browser_context->AsBrowserContext())
+                      : nullptr;
+  if (!net_log) {
+    callback->OnNetLogComplete("No net log in progress");
+    return;
+  }
+  net_log->Stop(callback);
+}
