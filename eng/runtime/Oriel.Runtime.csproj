<Project Sdk="Microsoft.NET.Sdk">
  <!-- Oriel.Runtime.<rid>: CEF and Oriel's native executables for one RID, from a folder an eng/runtime/stage-*
       script filled. Its runtimes/<rid>/native files land beside the app on a RID-specific publish.
       dotnet pack eng/runtime/Oriel.Runtime.csproj -p:OrielRuntimeRid=linux-x64 -p:OrielRuntimeStage=<dir> -o <feed> -->

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Oriel.Runtime.$(OrielRuntimeRid)</PackageId>
    <Description>Chromium (CEF) and Oriel's native host for $(OrielRuntimeRid), for apps built with Oriel.</Description>
    <PackageTags>cef;chromium;oriel</PackageTags>
    <!-- CEF's own licence; Chromium's third-party notices ship in the distribution's credits. -->
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <EnableDefaultItems>false</EnableDefaultItems>
    <!-- Native files only: no lib/ folder is intended. -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(OrielRuntimeStage)/native/*" Pack="true" PackagePath="runtimes/$(OrielRuntimeRid)/native/" />
    <!-- NuGet flattens native subfolders; the targets file copies these into locales/. -->
    <None Include="$(OrielRuntimeStage)/native/locales/*.pak" Pack="true" PackagePath="locales/" />
    <None Include="Oriel.Runtime.targets" Pack="true" PackagePath="buildTransitive/$(PackageId).targets" />
    <None Include="$(OrielRuntimeStage)/LICENSE.txt" Pack="true" PackagePath="" />
  </ItemGroup>

  <Target Name="_OrielCheckRuntimeStage" BeforeTargets="GenerateNuspec">
    <Error Condition="'$(OrielRuntimeRid)' == ''" Text="Set OrielRuntimeRid (for example linux-x64)." />
    <Error Condition="!Exists('$(OrielRuntimeStage)/native')" Text="OrielRuntimeStage '$(OrielRuntimeStage)' has no native folder: run an eng/runtime/stage-* script first." />
  </Target>
</Project>
