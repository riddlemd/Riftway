<Project>
  <!-- Packed as buildTransitive/Oriel.Runtime.<rid>.targets. NuGet flattens native assets, and CEF looks for its
       locales in a locales folder beside libcef, so they travel here instead. -->
  <PropertyGroup>
    <_OrielRuntimePackageId>$(MSBuildThisFileName)</_OrielRuntimePackageId>
    <_OrielRuntimeRid>$(_OrielRuntimePackageId.Substring(14))</_OrielRuntimeRid>
    <!-- A RID-less build (dotnet build/run) on the machine this runtime is for: NuGet leaves native assets under
         runtimes/<rid>/native, where OrielApp never looks for libcef, so they go beside the app as a RID build's do.
         macOS is left out: its dev build is an app bundle (Oriel.targets). -->
    <_OrielRuntimeFlatten Condition="'$(RuntimeIdentifier)' == '' and '$(NETCoreSdkRuntimeIdentifier)' == '$(_OrielRuntimeRid)' and !$(_OrielRuntimeRid.StartsWith('osx-'))">true</_OrielRuntimeFlatten>
  </PropertyGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' != '' or '$(_OrielRuntimeFlatten)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)..\locales\*.pak" Link="locales\%(Filename)%(Extension)" Visible="false"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="_OrielRuntimeFlattenNative" AfterTargets="ResolvePackageAssets" Condition="'$(_OrielRuntimeFlatten)' == 'true'">
    <ItemGroup>
      <RuntimeTargetsCopyLocalItems Update="@(RuntimeTargetsCopyLocalItems)"
                                    Condition="'%(RuntimeTargetsCopyLocalItems.NuGetPackageId)' == '$(_OrielRuntimePackageId)' and '%(RuntimeTargetsCopyLocalItems.RuntimeIdentifier)' == '$(_OrielRuntimeRid)'"
                                    DestinationSubDirectory="" DestinationSubPath="%(Filename)%(Extension)" />
    </ItemGroup>
  </Target>
</Project>
