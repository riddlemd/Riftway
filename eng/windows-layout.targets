<Project>
  <!-- dotnet publish -r win-x64 -p:RiftwayWindowsLayout=true: the sandboxed layout eng/layout-windows.ps1 makes, as a
       publish step. Imported only when RiftwayWindowsLayout is true (Directory.Build.targets). -->
  <PropertyGroup>
    <!-- <Exe>.dll is the native host, so the exe cannot take the managed assembly's name. -->
    <RiftwayExeName Condition="'$(RiftwayExeName)' == ''">$(AssemblyName)Run</RiftwayExeName>
    <RiftwayPwsh Condition="'$(RiftwayPwsh)' == ''">pwsh</RiftwayPwsh>
    <_RiftwayCefPlatform Condition="'$(RuntimeIdentifier)' == 'win-x64'">windows64</_RiftwayCefPlatform>
    <_RiftwayCefPlatform Condition="'$(RuntimeIdentifier)' == 'win-arm64'">windowsarm64</_RiftwayCefPlatform>
    <_RiftwayRepo>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..'))</_RiftwayRepo>
    <_RiftwayHostDir>$(_RiftwayRepo)src\Riftway.Host.Native\</_RiftwayHostDir>
    <_RiftwayHostDll>$(_RiftwayHostDir)obj\$(RuntimeIdentifier)\Riftway.Host.dll</_RiftwayHostDll>
  </PropertyGroup>

  <Target Name="RiftwayWindowsLayout" AfterTargets="Publish"
          Condition="'$(OS)' == 'Windows_NT' and $(RuntimeIdentifier.StartsWith('win-'))"
          DependsOnTargets="_RiftwayCheckWindowsLayout;RiftwayBuildWindowsHost">
    <Exec Command="&quot;$(RiftwayPwsh)&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(_RiftwayRepo)eng\layout-windows.ps1&quot; &quot;$(PublishDir.TrimEnd('\'))&quot; &quot;$(_RiftwayHostDll)&quot; &quot;$(RiftwayExeName)&quot; -App &quot;$(AssemblyName)&quot; -Platform $(_RiftwayCefPlatform)" />
  </Target>

  <Target Name="_RiftwayCheckWindowsLayout">
    <Error Condition="'$(_RiftwayCefPlatform)' == ''" Text="RiftwayWindowsLayout needs RuntimeIdentifier win-x64 or win-arm64, not '$(RuntimeIdentifier)'." />
    <Error Condition="'$(SelfContained)' != 'true'" Text="RiftwayWindowsLayout needs a self-contained publish (--self-contained): bootstrap.exe starts .NET through hostfxr beside it." />
    <Error Condition="'$(PublishSingleFile)' == 'true'" Text="RiftwayWindowsLayout cannot lay out a single-file publish." />
    <Error Condition="'$(RiftwayExeName)' == '$(AssemblyName)'" Text="RiftwayExeName '$(RiftwayExeName)' is the managed assembly's name; $(RiftwayExeName).dll must be the native host." />
  </Target>

  <!-- Once per RID, shared by every app; rebuilt only when its sources or the pinned CEF change. -->
  <Target Name="RiftwayBuildWindowsHost"
          Inputs="$(_RiftwayHostDir)host.c;$(_RiftwayHostDir)build.ps1;$(_RiftwayRepo)eng\cef.json;$(_RiftwayRepo)src\Riftway.Cef\Interop\CefApiVersion.cs"
          Outputs="$(_RiftwayHostDll)">
    <Exec Command="&quot;$(RiftwayPwsh)&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(_RiftwayHostDir)build.ps1&quot; &quot;$(_RiftwayHostDll)&quot; $(_RiftwayCefPlatform)" />
  </Target>
</Project>
